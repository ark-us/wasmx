{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wasmx-lobby",
  "description": "JSON Schema for wasmx-lobby TinyGo contract",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "GetParams": {
          "$ref": "#/definitions/MsgGetParams"
        }
      },
      "required": [
        "GetParams"
      ]
    },
    {
      "type": "object",
      "properties": {
        "InitGenesis": {
          "$ref": "#/definitions/MsgInitGenesis"
        }
      },
      "required": [
        "InitGenesis"
      ]
    }
  ],
  "definitions": {
    "ChainConfigData": {
      "type": "object",
      "properties": {
        "chain_config": {
          "type": "string",
          "x-go-type": "consensus.ChainConfig"
        },
        "chain_id": {
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "chain_config"
      ]
    },
    "CurrentChainSetup": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "x-go-type": "consensus.InitChainSetup"
        },
        "node": {
          "$ref": "#/definitions/NodeInfo"
        }
      },
      "required": [
        "data",
        "node"
      ]
    },
    "MetaregistryChainConfigData": {
      "type": "object",
      "properties": {
        "chain_id": {
          "type": "string",
          "x-go-type": "consensus.ChainId"
        },
        "config": {
          "type": "string",
          "x-go-type": "consensus.ChainConfig"
        }
      },
      "required": [
        "config",
        "chain_id"
      ]
    },
    "MetaregistryParams": {
      "type": "object",
      "properties": {
        "current_level": {
          "type": "integer"
        }
      },
      "required": [
        "current_level"
      ]
    },
    "MsgGetParams": {
      "type": "object"
    },
    "MsgInitGenesis": {
      "type": "object"
    },
    "MsgInitialize": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/definitions/MetaregistryParams"
        }
      },
      "required": [
        "params"
      ]
    },
    "MsgLastChainId": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "x-go-type": "consensus.ChainId"
        }
      },
      "required": [
        "id"
      ]
    },
    "MsgLastNodeId": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "MsgNewChainAccepted": {
      "type": "object",
      "properties": {
        "chainId": {
          "type": "string",
          "x-go-type": "consensus.ChainId"
        },
        "level": {
          "type": "integer"
        },
        "validators": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PotentialValidator"
          }
        }
      },
      "required": [
        "level",
        "chainId",
        "validators"
      ]
    },
    "MsgNewChainGenesisData": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "x-go-type": "registrylib.SubChainData"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validators": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PotentialValidator"
          }
        }
      },
      "required": [
        "data",
        "validators",
        "signatures"
      ]
    },
    "MsgNewChainRequest": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer"
        },
        "validator": {
          "$ref": "#/definitions/PotentialValidator"
        }
      },
      "required": [
        "level",
        "validator"
      ]
    },
    "MsgNewChainResponse": {
      "type": "object",
      "properties": {
        "msg": {
          "$ref": "#/definitions/MsgNewChainAccepted"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "msg",
        "signatures"
      ]
    },
    "MsgSetChainDataRequest": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/MetaregistryChainConfigData"
        }
      },
      "required": [
        "data"
      ]
    },
    "MsgSetChainDataResponse": {
      "type": "object"
    },
    "NetworkNode": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "peer_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "address",
        "peer_id"
      ]
    },
    "NodeInfo": {
      "type": "object",
      "properties": {
        "addr": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "addr"
      ]
    },
    "Params": {
      "type": "object",
      "properties": {
        "current_level": {
          "type": "integer"
        },
        "derc20CodeId": {
          "type": "integer"
        },
        "enable_eid_check": {
          "type": "boolean"
        },
        "erc20CodeId": {
          "type": "integer"
        },
        "level_initial_balance": {
          "type": "string",
          "format": "bigint",
          "x-go-type": "bigint"
        },
        "min_validators_count": {
          "type": "integer"
        }
      },
      "required": [
        "current_level",
        "min_validators_count",
        "enable_eid_check",
        "erc20CodeId",
        "derc20CodeId",
        "level_initial_balance"
      ]
    },
    "PotentialValidator": {
      "type": "object",
      "properties": {
        "addressBytes": {
          "type": "string"
        },
        "consensusPublicKey": {
          "type": "string"
        },
        "node": {
          "$ref": "#/definitions/NetworkNode"
        }
      },
      "required": [
        "node",
        "addressBytes",
        "consensusPublicKey"
      ]
    },
    "PotentialValidatorWithSignature": {
      "type": "object",
      "properties": {
        "signature": {
          "type": "string"
        },
        "validator": {
          "$ref": "#/definitions/PotentialValidator"
        }
      },
      "required": [
        "validator",
        "signature"
      ]
    },
    "QueryGetChainDataRequest": {
      "type": "object",
      "properties": {
        "chain_id": {
          "type": "string"
        }
      },
      "required": [
        "chain_id"
      ]
    },
    "QueryGetChainDataResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/MetaregistryChainConfigData"
        }
      },
      "required": [
        "data"
      ]
    },
    "QueryGetSubChainRequest": {
      "type": "object",
      "properties": {
        "chainId": {
          "type": "string"
        }
      },
      "required": [
        "chainId"
      ]
    },
    "QueryGetSubChainsByIdsRequest": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ids"
      ]
    },
    "QuerySubChainConfigByIdsRequest": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ids"
      ]
    }
  }
}