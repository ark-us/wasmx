{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wasmx-slashing",
  "description": "JSON Schema for wasmx-slashing TinyGo contract",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "GetParams": {
          "$ref": "#/definitions/MsgGetParams"
        }
      },
      "required": [
        "GetParams"
      ]
    },
    {
      "type": "object",
      "properties": {
        "InitGenesis": {
          "$ref": "#/definitions/MsgInitGenesis"
        }
      },
      "required": [
        "InitGenesis"
      ]
    }
  ],
  "definitions": {
    "GenesisState": {
      "type": "object",
      "properties": {
        "missed_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ValidatorMissedBlocks"
          }
        },
        "params": {
          "$ref": "#/definitions/Params"
        },
        "signing_infos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SigningInfo"
          }
        }
      },
      "required": [
        "params",
        "signing_infos",
        "missed_blocks"
      ]
    },
    "MissedBlock": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "missed": {
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "missed"
      ]
    },
    "MsgGetParams": {
      "type": "object"
    },
    "MsgInitGenesis": {
      "type": "object"
    },
    "MsgRunHook": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        }
      },
      "required": [
        "hook",
        "data"
      ]
    },
    "Params": {
      "type": "object",
      "properties": {
        "downtime_jail_duration": {
          "type": "string"
        },
        "min_signed_per_window": {
          "type": "string"
        },
        "signed_blocks_window": {
          "type": "integer"
        },
        "slash_fraction_double_sign": {
          "type": "string"
        },
        "slash_fraction_downtime": {
          "type": "string"
        }
      },
      "required": [
        "signed_blocks_window",
        "min_signed_per_window",
        "downtime_jail_duration",
        "slash_fraction_double_sign",
        "slash_fraction_downtime"
      ]
    },
    "ParamsExternal": {
      "type": "object",
      "properties": {
        "downtime_jail_duration": {
          "type": "string"
        },
        "min_signed_per_window": {
          "type": "string"
        },
        "signed_blocks_window": {
          "type": "string"
        },
        "slash_fraction_double_sign": {
          "type": "string"
        },
        "slash_fraction_downtime": {
          "type": "string"
        }
      },
      "required": [
        "signed_blocks_window",
        "min_signed_per_window",
        "downtime_jail_duration",
        "slash_fraction_double_sign",
        "slash_fraction_downtime"
      ]
    },
    "QueryMissedBlockBitmapRequest": {
      "type": "object",
      "properties": {
        "cons_address": {
          "type": "string"
        }
      },
      "required": [
        "cons_address"
      ]
    },
    "QueryMissedBlockBitmapResponse": {
      "type": "object",
      "properties": {
        "chunks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "chunks"
      ]
    },
    "QueryParamsRequest": {
      "type": "object"
    },
    "QueryParamsResponse": {
      "type": "object",
      "properties": {
        "params": {
          "$ref": "#/definitions/Params"
        }
      },
      "required": [
        "params"
      ]
    },
    "QuerySigningInfoRequest": {
      "type": "object",
      "properties": {
        "cons_address": {
          "type": "string"
        }
      },
      "required": [
        "cons_address"
      ]
    },
    "QuerySigningInfoResponse": {
      "type": "object",
      "properties": {
        "val_signing_info": {
          "$ref": "#/definitions/ValidatorSigningInfo"
        }
      },
      "required": [
        "val_signing_info"
      ]
    },
    "QuerySigningInfosRequest": {
      "type": "object",
      "properties": {
        "pagination": {
          "type": "string",
          "x-go-type": "wasmx.PageRequest"
        }
      },
      "required": [
        "pagination"
      ]
    },
    "QuerySigningInfosResponse": {
      "type": "object",
      "properties": {
        "info": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ValidatorSigningInfo"
          }
        },
        "pagination": {
          "type": "string",
          "x-go-type": "wasmx.PageResponse"
        }
      },
      "required": [
        "info",
        "pagination"
      ]
    },
    "SigningInfo": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "format": "consensus-address"
        },
        "validator_signing_info": {
          "$ref": "#/definitions/ValidatorSigningInfo"
        }
      },
      "required": [
        "address",
        "validator_signing_info"
      ]
    },
    "ValidatorMissedBlocks": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "format": "consensus-address"
        },
        "missed_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MissedBlock"
          }
        }
      },
      "required": [
        "address",
        "missed_blocks"
      ]
    },
    "ValidatorSigningInfo": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "format": "consensus-address"
        },
        "index_offset": {
          "type": "integer"
        },
        "jailed_until": {
          "type": "string",
          "x-go-type": "time.Time"
        },
        "missed_blocks_counter": {
          "type": "integer"
        },
        "start_height": {
          "type": "integer"
        },
        "tombstoned": {
          "type": "boolean"
        }
      },
      "required": [
        "address",
        "start_height",
        "index_offset",
        "jailed_until",
        "tombstoned",
        "missed_blocks_counter"
      ]
    }
  }
}